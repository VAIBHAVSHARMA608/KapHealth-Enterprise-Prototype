# ---- Core ----
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# ---- Database ----
MONGO_URI=mongodb://localhost:27017/kaphealth

# ---- Auth / JWT ----
JWT_ACCESS_SECRET=replace_with_long_random_string
JWT_REFRESH_SECRET=replace_with_another_long_random_string
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

# ---- Google OAuth (https://console.cloud.google.com/apis/credentials) ----
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ---- WhatsApp OTP login (Meta WhatsApp Cloud API) ----
# Create a Meta developer app + WhatsApp product: https://developers.facebook.com/docs/whatsapp/cloud-api
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_whatsapp_permanent_access_token
WHATSAPP_OTP_TEMPLATE_NAME=kaphealth_otp
WHATSAPP_API_VERSION=v20.0

# ---- Payments: Razorpay (supports UPI/cards + you flag COD manually) ----
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# ---- Hidden Admin Panel ----
ADMIN_PANEL_PATH_SECRET=kap-ops-9f2a1c        # used to build the obscure frontend route
ADMIN_ACCESS_KEY=replace_with_long_random_string  # required header for all /api/admin/* calls
ADMIN_SEED_EMAIL=owner@kaphealth.com
ADMIN_SEED_PASSWORD=ChangeThisImmediately!123

# ---- File uploads (doctor documents, prescriptions) ----
UPLOAD_DIR=uploads

# ---- STUN/TURN for WebRTC video (coturn or a provider like Twilio NTS / Metered) ----
TURN_URLS=turn:your-turn-server:3478
TURN_USERNAME=your_turn_username
TURN_CREDENTIAL=your_turn_credential
