# Copy this file to .env (same folder -- server/src/.env) and fill in real
# values before deploying. Everything below has a working default for LOCAL
# TESTING except MONGO_URI (point it at your own MongoDB instance).
#
# IMPORTANT: in production (NODE_ENV=production) the server now REFUSES to
# start if JWT_ACCESS_SECRET, JWT_REFRESH_SECRET, or ADMIN_ACCESS_KEY are
# left as the example values below, or if ENABLE_TEST_LOGIN isn't explicitly
# "false". Generate real random secrets (e.g. `openssl rand -hex 32`) first.

# ---- Core ----
NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/kaphealth
CLIENT_URL=http://localhost:5173

# ---- Auth tokens ----
JWT_ACCESS_SECRET=dev_access_secret_change_me
JWT_REFRESH_SECRET=dev_refresh_secret_change_me
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

# ---- Hidden admin panel ----
# ADMIN_ACCESS_KEY is required on every /api/admin/* request (sent as the
# x-admin-key header) IN ADDITION to logging in -- a second, static secret.
ADMIN_ACCESS_KEY=dev_admin_access_key_change_me
# Credentials for the one-time admin bootstrap (auto-creates the admin
# account the first time you log in with these via the test-login form, or
# via `npm run seed:admin`). Only works while zero admin accounts exist yet.
ADMIN_SEED_EMAIL=admin@kaphealth.test
ADMIN_SEED_PASSWORD=Admin@12345

# ---- Dev/test-only patient & doctor login (see `npm run seed:test`) ----
# Lets you log in as any seeded patient/doctor with email/phone + this
# password instead of a WhatsApp OTP. MUST be "false" in production --
# the server will refuse to boot otherwise.
ENABLE_TEST_LOGIN=true
TEST_ACCOUNT_PASSWORD=Kap@Test123

# ---- WhatsApp OTP (Twilio) ----
# Leave blank for local testing: OTPs will be printed to the server console
# instead of sent, so login still works end-to-end without a Twilio account.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=

# ---- Google Sign-In ----
GOOGLE_CLIENT_ID=

# ---- Notifications (Phase 3) ----
# Leave blank for local testing: emails/SMS "send" by printing to the server
# console instead, so the whole notification flow still works end-to-end.
SMTP_HOST=
SMTP_USER=
SMTP_PASS=
TWILIO_SMS_NUMBER=

# ---- Razorpay ----
# Leave blank (or leave as the bundled placeholder) for local testing:
# bookings/orders auto-capture in "dev mode" with no real payment gateway
# call. Set both to real TEST keys from your Razorpay dashboard to exercise
# the actual Razorpay checkout widget instead.
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=placeholder_secret

# ---- WebRTC TURN server (optional) ----
# Only needed if peer-to-peer video calls fail behind strict NATs/firewalls.
# STUN (google's public server) is used by default with no config needed.
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=

# ---- File uploads ----
UPLOAD_DIR=uploads
